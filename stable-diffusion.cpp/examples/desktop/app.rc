        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SD-Studio - offline FLUX.2 klein image generation (stable-diffusion.cpp)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SD-Studio"
            VALUE "OriginalFilename", "SD-Studio.exe"
            VALUE "ProductName", "SD-Studio"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
